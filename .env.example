# SatHop local dev — minimal starter for running components from this repo.
# For container deployments, see deploy/<component>/.env.example instead.
#
# Pick ONE component and uncomment the matching block. All three components
# share `SATHOP_TOKEN` (same string everywhere — bearer-token auth).

SATHOP_TOKEN=dev-token

# ── orchestrator (python -m sathop.orchestrator.main) ──
SATHOP_HOST=127.0.0.1
SATHOP_PORT=8765
SATHOP_DB=./data/orchestrator.db
SATHOP_BUNDLES=./data/bundles
SATHOP_SHARED=./data/shared

# ── worker (python -m sathop.worker.main) ──
# SATHOP_WORKER_ID=worker-dev
# SATHOP_PUBLIC_URL=http://127.0.0.1:9000
# SATHOP_URL=sathop://dev-token@127.0.0.1:8765
# SATHOP_CAPACITY=4
# SATHOP_WORK_ROOT=./data/work
# SATHOP_BUNDLE_CACHE=./data/bundles-cache
# SATHOP_VENV_CACHE=./data/venvs
# SATHOP_SHARED_CACHE=./data/shared-cache
# SATHOP_STORAGE_ROOT=./data/storage
# SATHOP_STORAGE_PORT=9000

# ── receiver (python -m sathop.receiver.main) ──
# SATHOP_RECEIVER_ID=recv-dev
# SATHOP_URL=sathop://dev-token@127.0.0.1:8765
# SATHOP_STORAGE_DIR=./data/archive
# SATHOP_TLS_VERIFY=false  # default true; flip off only for self-signed dev orch
