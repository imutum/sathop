# ── image（默认指向 imutum 官方镜像；自部署可改为你的 GitHub 用户名或组织名）──
SATHOP_IMAGE=ghcr.io/imutum/sathop
SATHOP_TAG=latest

# ── required ──
SATHOP_WORKER_ID=worker-1
SATHOP_PUBLIC_URL=http://worker-1.example.com:9000

# Single connection string carrying both orch URL and token (Redis-style).
#   sathop://TOKEN@host:port    → plain HTTP
#   sathops://TOKEN@host:port   → HTTPS (use when orch is fronted by a reverse proxy)
SATHOP_URL=sathop://change-me@orchestrator.example.com:8000

# Alternative: split form (used as fallback only if SATHOP_URL is unset).
# SATHOP_ORCH_URL=http://orchestrator.example.com:8000
# SATHOP_TOKEN=change-me

# ── capacity / paths ──
SATHOP_CAPACITY=20
SATHOP_WORK_ROOT=./data/work
SATHOP_BUNDLE_CACHE=./data/bundles
SATHOP_VENV_CACHE=./data/venvs
SATHOP_SHARED_CACHE=./data/shared
SATHOP_STORAGE_ROOT=./data/storage
SATHOP_STORAGE_PORT=9000
# Bundle progress callbacks + /health endpoint (docker healthcheck targets
# this). Bound to 127.0.0.1 inside the container; not exposed externally.
SATHOP_PROGRESS_PORT=9002
SATHOP_HEARTBEAT=15
SATHOP_LEASE_POLL=10

# Concurrent download cap (downloads only — process/upload still run in parallel).
# 1 = one granule saturates the link → reaches processing fastest. Bump up if
# bandwidth is plentiful and a single connection can't fill the pipe.
SATHOP_DOWNLOAD_CONCURRENCY=1

# Concurrent processing slots — defaults to os.cpu_count(). Lower for memory-
# heavy bundles; raise on machines with idle cores.
# SATHOP_PROCESS_CONCURRENCY=

# Concurrent upload slots. Defaults to SATHOP_PROCESS_CONCURRENCY. Lower for
# MinIO-over-WAN to avoid saturating the uplink and starving receiver pulls.
# SATHOP_UPLOAD_CONCURRENCY=

# ── TLS (optional; only when SATHOP_PUBLIC_URL starts with https://) ──
# Self-signed cert + key for the storage HTTP server. Auto-generated on first
# boot under SATHOP_WORK_ROOT/tls/ if these point at non-existent paths.
# Override only to supply a publicly-trusted cert/key pair.
# SATHOP_TLS_CERT=./data/tls/cert.pem
# SATHOP_TLS_KEY=./data/tls/key.pem

# ── Credentials ──
# Not set here. Credentials ride on each lease from the orchestrator — the
# user specifies them per-batch at creation time (BatchCreate.credentials).

# ── Backpressure (optional; sensible defaults) ──
SATHOP_DISK_PAUSE_PCT=0.85
SATHOP_DISK_RESUME_PCT=0.70
SATHOP_BACKPRESSURE_INTERVAL=10

# ── Local cache GC (optional; sensible defaults) ──
# Periodically evict the oldest cached venvs (and their bundle source dirs)
# once total venv cache exceeds the limit. ensure() refreshes a per-bundle
# LRU sidecar on every lease, so an actively-used bundle is never evicted.
# Also cleans up shared-file cache orphans (names removed from orch registry).
# Set SATHOP_GC_INTERVAL=0 to disable the loop entirely; set the limit to 0
# to disable just the venv eviction (orphan cleanup still runs).
SATHOP_VENV_CACHE_LIMIT_GB=10
SATHOP_GC_INTERVAL=3600

# ── aria2c RPC (optional; empty = fall back to httpx) ──
SATHOP_ARIA2_RPC=
SATHOP_ARIA2_SECRET=
# Override only if you've validated a newer p3terx/aria2-pro tag.
# SATHOP_ARIA2_TAG=2024.10.20

# ── MinIO (optional; empty = fall back to local FS + static HTTP server) ──
# Endpoint is derived from SATHOP_PUBLIC_URL (presigned URLs need the public host).
SATHOP_MINIO_ACCESS_KEY=
SATHOP_MINIO_SECRET_KEY=
SATHOP_MINIO_BUCKET=sathop
# Override only if you've validated a newer minio/minio release.
# SATHOP_MINIO_TAG=RELEASE.2024-12-18T13-15-44Z
