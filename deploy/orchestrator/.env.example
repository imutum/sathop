# ── image ──
SATHOP_IMAGE=ghcr.io/imutum/sathop
SATHOP_TAG=latest

# ── release bundle ──
# Which release the entrypoint installs on FIRST boot (downloads + extracts the
# self-contained sathop-bundle.tar.gz: backend + matching frontend, one package).
# "latest" tracks the newest release on first boot only; once installed, a
# restart keeps the installed version (upgrades are explicit, via the UI or by
# changing this and recreating the container). Pin to e.g. 0.6.21 to freeze.
SATHOP_VERSION=latest
# Override the release source (default: github.com/imutum/sathop). Private repo
# assets need a token.
# SATHOP_GIT_REPO=https://github.com/imutum/sathop.git
# SATHOP_GIT_TOKEN=
# Release channel the version banner tracks: "stable" (default — newest promoted
# release) or "edge" (newest, incl. prereleases). Read-only: upgrading still
# installs a concrete version. Tagged builds publish to edge; promote to stable
# via the Promote GitHub workflow.
# SATHOP_CHANNEL=stable

# Worker reporting verbosity, pushed to the whole fleet via the heartbeat reply.
# "verbose" (default): workers report every per-stage transition (download_started,
# process_started) + display progress — best for early bring-up / debugging.
# "fast": workers skip those waypoints + progress and report only the terminal
# upload_completed (which still carries the measured stage durations) — fewer
# orchestrator writes at scale, at the cost of live per-stage WIP visibility.
# Flip it and restart the orchestrator (~15s) to re-push to the fleet; workers
# honor it live, no worker restart.
# SATHOP_WORKER_DETAIL=verbose

# UID/GID — host 的 ./data 必须可被该 UID 写入
# SATHOP_UID=10001
# SATHOP_GID=10001

SATHOP_HOST=0.0.0.0
SATHOP_PORT=8000
SATHOP_DEV=0
SATHOP_DB=./data/orchestrator.db
SATHOP_BUNDLES=./data/bundles
SATHOP_SHARED=./data/shared
SATHOP_TOKEN=change-me-to-a-long-random-string

# ── multi-process scaling (route A) ──
# Default is single-process SQLite (state in ./data above) — leave this block
# commented and the orchestrator runs one core, one event loop, no Postgres.
#
# To scale onto N cores: set both vars below, then bring the stack up with
#   docker compose --profile scale up -d
# Postgres then holds ALL authoritative state (back ./pgdata up like ./data) and
# carries the cross-process pub/sub via LISTEN/NOTIFY — no Redis. Run N uvicorn
# workers ≈ your core count. Migrate existing SQLite state in FIRST (one-time):
#   python scripts/migrate_sqlite_to_pg.py ./data/orchestrator.db "$SATHOP_DATABASE_URL"
# The host:port/user must match the postgres service (set SATHOP_PG_PASSWORD too).
# SATHOP_PG_USER=sathop
# SATHOP_PG_PASSWORD=change-me-to-a-long-random-string
# SATHOP_PG_DB=sathop
# SATHOP_DATABASE_URL=postgresql+asyncpg://sathop:change-me-to-a-long-random-string@postgres:5432/sathop
# SATHOP_ORCH_WORKERS=4

# Credentials are specified per-batch at creation time (BatchCreate.credentials)
# and ride on each lease — there's no orchestrator-side registry or YAML file.

# Retention sweeper. Set any value to 0 to keep rows forever / disable the loop.
SATHOP_RETAIN_EVENTS_DAYS=30
SATHOP_RETAIN_DELETED_DAYS=7
SATHOP_RETENTION_SWEEP_SEC=3600

# Auto-blacklist threshold: a granule that fails this many times stops being
# retried automatically. Operator can still hit "重试" in the UI to reset.
SATHOP_MAX_RETRIES=3

# After this many receiver pull failures on the same object the orchestrator
# stops offering it (avoid spinning forever on a permanently-broken URL).
SATHOP_MAX_PULL_FAILURES=5

# Per-worker cap on in-flight (leased or post-upload-pre-delete) granules.
# 0 = no cap (rely solely on worker's self-reported capacity). Set a positive
# integer when you've measured that a worker's CPU/disk pipeline saturates
# below the capacity number it advertises.
SATHOP_MAX_INFLIGHT_PER_WORKER=0

# "Stuck" alarm threshold in hours: a non-terminal granule with no state
# progress for this long is flagged on the dashboard, /metrics, and reconcile.
# Float — set below 1 (e.g. 0.5) to tighten for live monitoring. This is a
# coarse "something's wrong" alarm; live bottleneck reading is done off the
# per-stage WIP numbers, not this threshold.
SATHOP_STUCK_AGE_HOURS=6
