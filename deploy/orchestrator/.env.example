# ── image ──
SATHOP_IMAGE=ghcr.io/imutum/sathop
SATHOP_TAG=latest

# ── runtime shell ──
# SATHOP_GIT_REPO=https://github.com/imutum/sathop.git
# SATHOP_GIT_REF=main
# SATHOP_GIT_TOKEN=

# UID/GID — host 的 ./data 必须可被该 UID 写入
# SATHOP_UID=10001
# SATHOP_GID=10001

SATHOP_HOST=0.0.0.0
SATHOP_PORT=8000
SATHOP_DEV=0
SATHOP_DB=./data/orchestrator.db
SATHOP_BUNDLES=./data/bundles
SATHOP_SHARED=./data/shared
SATHOP_TOKEN=change-me-to-a-long-random-string

# Credentials are specified per-batch at creation time (BatchCreate.credentials)
# and ride on each lease — there's no orchestrator-side registry or YAML file.

# Retention sweeper. Set any value to 0 to keep rows forever / disable the loop.
SATHOP_RETAIN_EVENTS_DAYS=30
SATHOP_RETAIN_DELETED_DAYS=7
SATHOP_RETENTION_SWEEP_SEC=3600

# Auto-blacklist threshold: a granule that fails this many times stops being
# retried automatically. Operator can still hit "重试" in the UI to reset.
SATHOP_MAX_RETRIES=3

# After this many receiver pull failures on the same object the orchestrator
# stops offering it (avoid spinning forever on a permanently-broken URL).
SATHOP_MAX_PULL_FAILURES=5

# Per-worker cap on in-flight (leased or post-upload-pre-delete) granules.
# 0 = no cap (rely solely on worker's self-reported capacity). Set a positive
# integer when you've measured that a worker's CPU/disk pipeline saturates
# below the capacity number it advertises.
SATHOP_MAX_INFLIGHT_PER_WORKER=0
