# ── image（默认指向 imutum 官方镜像；自部署可改为你的 GitHub 用户名或组织名）──
SATHOP_IMAGE=ghcr.io/imutum/sathop
SATHOP_TAG=latest

# 容器内进程运行的 UID/GID（镜像内置 10001:10001，非 root）。host 上的
# 归档目录（默认 ./archive，可被 RECEIVER_HOST_ARCHIVE 覆盖）必须能被该 UID
# 写入：要么 `chown 10001:10001 ./archive`，要么把这里改成你的账户 UID
# （`id -u`）。
# SATHOP_UID=10001
# SATHOP_GID=10001

# ── required ──
SATHOP_RECEIVER_ID=recv-home
SATHOP_STORAGE_DIR=/data/archive

# Single connection string carrying both orch URL and token (Redis-style).
#   sathop://TOKEN@host:port    → plain HTTP
#   sathops://TOKEN@host:port   → HTTPS (use when orch is fronted by a reverse proxy)
SATHOP_URL=sathop://change-me@orchestrator.example.com:8000

# Alternative: split form (used as fallback only if SATHOP_URL is unset).
# SATHOP_ORCH_URL=http://orchestrator.example.com:8000
# SATHOP_TOKEN=change-me

# ── optional (defaults shown) ──
SATHOP_POLL_INTERVAL=10
SATHOP_CONCURRENT_PULLS=4
# /health endpoint port. Bound to 127.0.0.1 inside the container — docker
# healthcheck targets this. Not exposed externally; no auth.
SATHOP_HEALTH_PORT=9003

# TLS：默认完全验证 + 信任 orchestrator 聚合的 worker CA bundle。worker 用
# 自签 IP/SAN cert（无域名场景）时这是唯一可行的信任源；若所有 worker 都
# 用公网受信任 cert，bundle 端点返回 204，receiver 自动回退到系统 CA。
# 仅在你完全自管 trust（mTLS 等）时把 SATHOP_TLS_TRUST_ORCH=false。
# SATHOP_TLS_VERIFY=true
# SATHOP_TLS_TRUST_ORCH=true
